# Telephony Control - standalone configuration template.
# Copy to .env and replace every GENERATE-/CHANGE-ME value. Never commit .env.

# ---------------------------------------------------------------- core app
FLASK_ENV=production
SECRET_KEY=GENERATE-A-RANDOM-32-BYTE-OR-LONGER-SECRET
TELEPHONY_TOKEN=GENERATE-A-RANDOM-32-BYTE-OR-LONGER-TOKEN
# MySQL is the production store. The database and user must already exist;
# application tables are created on first start. URL-encode special characters.
DATABASE_URI=mysql+pymysql://eip:PASSWORD@host.docker.internal:3306/telephony?charset=utf8mb4

# Optional: DATABASE_URI uses an existing MySQL container's Docker hostname.
# Enable the database-network override; no CRM connection is required. Linux:
# MYSQL_DOCKER_NETWORK=1panel-network
# COMPOSE_FILE=docker-compose.yml:docker-compose.mysql-network.yml

# Optional custom image repositories (no tag); defaults are neutral local tags.
# TELEPHONY_API_IMAGE=telephony-control/api
# TELEPHONY_ASTERISK_IMAGE=telephony-control/asterisk
# Existing engineerip/* deployment? BEFORE replacing Compose, include
# docker-compose.legacy-names.yml in COMPOSE_FILE. See docs/DOCKER_NAMING_MIGRATION.md.

# ------------------------------------------------- first-run administrator
# Used only to create the administrator when none exists yet. Change the
# password from the console after signing in.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=GENERATE-A-14-CHARACTER-OR-LONGER-PASSWORD

# ------------------------------------------------------- asterisk (private)
ASTERISK_ARI_URL=http://asterisk:8088/ari
ASTERISK_ARI_USER=engineerip
ASTERISK_ARI_PASSWORD=GENERATE-A-RANDOM-20-CHARACTER-OR-LONGER-PASSWORD
ASTERISK_AMI_HOST=asterisk
ASTERISK_AMI_USER=engineerip
ASTERISK_AMI_PASSWORD=GENERATE-A-RANDOM-20-CHARACTER-OR-LONGER-PASSWORD
# First-boot fallback for the public SIP/RTP address. Once the console's
# Service address is configured it is the single source of truth.
ASTERISK_EXTERNAL_ADDRESS=CHANGE-ME
# UDP range used for call audio. Asterisk's rtp.conf and Docker's published
# ports are both generated from these two values (defaults 10000-10100);
# open the same range in the VPS firewall.
ASTERISK_RTP_START=10000
ASTERISK_RTP_END=10100

# Every page links the bundled icon, and /favicon.ico redirects there.
# Override only to point a deployment at another image.
# FAVICON_URL=/static/images/favicon.svg

# Nothing else is required. This is a standalone service: point your CRM or
# any other system at the HTTPS API with a scoped API key, or register a signed
# webhook endpoint. No shared Docker network with another product is needed.
#
# The two blocks below are optional: they only pre-seed an empty database before
# the first sign-in. Leave them commented out unless you are migrating from an
# older deployment that kept telephony settings in the environment.
#
# ASTERISK_EXTENSIONS=101
# DEFAULT_EXTENSION=101
# EXTENSION_101_PASSWORD=GENERATE-A-UNIQUE-SIP-PASSWORD
#
# IPCOMMS_SIP_SERVER=CHANGE-ME.s1.ipcomms.net
# IPCOMMS_SIP_PORT=5060
# IPCOMMS_SIP_USERNAME=CHANGE-ME
# IPCOMMS_SIP_PASSWORD=GENERATE-A-UNIQUE-SIP-PASSWORD
# IPCOMMS_DID=+13022661626
# IPCOMMS_ALLOWED_IPS=203.0.113.10,203.0.113.11
