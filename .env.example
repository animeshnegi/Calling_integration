FLASK_ENV=production
SECRET_KEY=change-me
TELEPHONY_TOKEN=change-me-long-random-token
CRM_WEBHOOK_URL=http://engineerip-crm:5000/api/v1/telephony/events
CRM_WEBHOOK_TOKEN=change-me

# Asterisk / ARI. ARI stays private on the Docker network; port 8088 is not published.
ASTERISK_HOST=asterisk
ASTERISK_ARI_URL=http://asterisk:8088/ari
ASTERISK_ARI_USER=engineerip
ASTERISK_ARI_PASSWORD=change-me
ASTERISK_ARI_APP=engineerip

# Local SIP extensions. Add/remove extensions here; each one needs its own password.
# Example: 101,102,103,104
ASTERISK_EXTENSIONS=101
DEFAULT_EXTENSION=101
EXTENSION_101_PASSWORD=change-me-strong
# EXTENSION_102_PASSWORD=change-me-strong
# EXTENSION_103_PASSWORD=change-me-strong
# EXTENSION_104_PASSWORD=change-me-strong

# Browser WebRTC endpoints are optional. These use <extension>-web usernames.
# Example: 101,102,103
WEBRTC_EXTENSIONS=101
WEBRTC_EXTENSION=101-web
WEBRTC_EXTENSION_PASSWORD=change-me-strong
# WEBRTC_EXTENSION_102_PASSWORD=change-me-strong
# WEBRTC_EXTENSION_103_PASSWORD=change-me-strong

# Public hostname/address used by Asterisk for SIP signaling and RTP media NAT.
ASTERISK_EXTERNAL_ADDRESS=CHANGE-ME

# IPComms SIP registration trunk. Keep real values ONLY in .env on the VPS.
IPCOMMS_SIP_SERVER=CHANGE-ME.s1.ipcomms.net
IPCOMMS_SIP_PORT=5060
IPCOMMS_SIP_USERNAME=change-me
IPCOMMS_SIP_PASSWORD=change-me
IPCOMMS_DID=+13022661626

# REQUIRED: comma-separated IP addresses/CIDRs supplied by IPComms for inbound SIP identification.
# Do not leave this blank in the VPS .env.
IPCOMMS_ALLOWED_IPS=203.0.113.10,203.0.113.11

# RTP range. Docker publishes this exact range and the VPS firewall must allow UDP traffic here.
ASTERISK_RTP_START=10000
ASTERISK_RTP_END=10100

# Application/web settings
PUBLIC_WEBRTC_HOST=telephony.example.com
PUBLIC_WEBRTC_SCHEME=https
SIP_OUTBOUND_PREFIX=
