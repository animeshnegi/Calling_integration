# Generate real secrets; never use the example values in production.
FLASK_ENV=production
SECRET_KEY=GENERATE-A-RANDOM-32-BYTE-OR-LONGER-SECRET
TELEPHONY_TOKEN=GENERATE-A-RANDOM-32-BYTE-OR-LONGER-TOKEN
CRM_WEBHOOK_URL=http://engineerip-crm:5000/api/v1/telephony/events
CRM_WEBHOOK_TOKEN=GENERATE-A-RANDOM-LONG-TOKEN

# First-run admin bootstrap. The password is copied into the settings DB only when it is empty.
# Change it immediately from /admin after deployment. Do not put this in source control.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=GENERATE-A-14-CHARACTER-OR-LONGER-PASSWORD
SETTINGS_DB_PATH=/app/instance/settings.db

# Asterisk / ARI. ARI 8088 is private to the Docker network and is never published.
ASTERISK_HOST=asterisk
ASTERISK_ARI_URL=http://asterisk:8088/ari
ASTERISK_ARI_USER=engineerip
ASTERISK_ARI_PASSWORD=GENERATE-A-RANDOM-20-CHARACTER-OR-LONGER-PASSWORD
ASTERISK_ARI_APP=engineerip

# Local SIP extensions. These remain the Asterisk bootstrap configuration for now.
# The admin database is the management layer; applying database changes to Asterisk will be added in the next stage.
ASTERISK_EXTENSIONS=101
DEFAULT_EXTENSION=101
EXTENSION_101_PASSWORD=GENERATE-A-UNIQUE-SIP-PASSWORD
# EXTENSION_102_PASSWORD=GENERATE-A-UNIQUE-SIP-PASSWORD

WEBRTC_EXTENSIONS=101
WEBRTC_EXTENSION=101-web
WEBRTC_EXTENSION_PASSWORD=GENERATE-A-UNIQUE-WEBRTC-PASSWORD
ENABLE_BROWSER_API=false
ENABLE_DIAGNOSTIC_UI=false

ASTERISK_EXTERNAL_ADDRESS=CHANGE-ME

IPCOMMS_SIP_SERVER=CHANGE-ME.s1.ipcomms.net
IPCOMMS_SIP_PORT=5060
IPCOMMS_SIP_USERNAME=CHANGE-ME
IPCOMMS_SIP_PASSWORD=GENERATE-A-UNIQUE-SIP-PASSWORD
IPCOMMS_DID=+13022661626
IPCOMMS_ALLOWED_IPS=203.0.113.10,203.0.113.11

ASTERISK_RTP_START=10000
ASTERISK_RTP_END=10100

PUBLIC_WEBRTC_HOST=telephony.example.com
PUBLIC_WEBRTC_SCHEME=https
SIP_OUTBOUND_PREFIX=
